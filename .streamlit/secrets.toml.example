# Copy to .streamlit/secrets.toml to run the Model Lab with Google login locally (never commit the real file).
# On Cloud Run, the same content lives in Secret Manager (cl-biometrics-streamlit-secrets), with the main URL.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "<python -c 'import secrets; print(secrets.token_urlsafe(48))'>"
client_id = "<OAuth client id>.apps.googleusercontent.com"
client_secret = "<OAuth client secret>"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
# Only accounts of the domain get in: the OAuth consent screen is Internal, and the page checks the verified e-mail
# and Google's hd claim again (allometry_app.policy.domain_allowed).

[allometry]
store = ".allometry-local"  # or gs://<bucket>
allowed_domain = "courageousland.com"
promoters = ["jeferson@courageousland.com"]
